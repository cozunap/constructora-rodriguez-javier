---
// MobileAppTabBar.astro
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/index.html';
const isProperties = pathname.includes('/properties') || pathname.includes('/proyecto');
const isServices = pathname.includes('/services');
const isAbout = pathname.includes('/about');
const isContact = pathname.includes('/contact');
---

<!-- Native App Style Bottom Tab Bar (Mobile Only) -->
<nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 dark:bg-navy/95 backdrop-blur-xl border-t border-mid/20 shadow-[0_-4px_25px_rgba(0,0,0,0.08)] px-2 py-1.5 pb-safe transition-transform duration-300" id="mobile-tab-bar" aria-label="Navegación Móvil de la App">
  <div class="grid grid-cols-5 items-center justify-around max-w-md mx-auto">
    
    <!-- Inicio -->
    <a href="/" class={`flex flex-col items-center justify-center py-1 px-1 transition-all group ${isHome ? 'text-gold' : 'text-navy/70 hover:text-gold'}`}>
      <div class={`p-1 rounded-xl transition-all ${isHome ? 'bg-gold/15 scale-110' : 'group-active:scale-95'}`}>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill={isHome ? "currentColor" : "none"} stroke="currentColor" stroke-width={isHome ? "1.5" : "2"} stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
      </div>
      <span class="text-[10px] font-medium tracking-tight mt-0.5">Inicio</span>
    </a>

    <!-- Propiedades -->
    <a href="/properties" class={`flex flex-col items-center justify-center py-1 px-1 transition-all group ${isProperties ? 'text-gold' : 'text-navy/70 hover:text-gold'}`}>
      <div class={`p-1 rounded-xl transition-all ${isProperties ? 'bg-gold/15 scale-110' : 'group-active:scale-95'}`}>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill={isProperties ? "currentColor" : "none"} stroke="currentColor" stroke-width={isProperties ? "1.5" : "2"} stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2"/>
          <path d="M3 9h18"/>
          <path d="M9 21V9"/>
        </svg>
      </div>
      <span class="text-[10px] font-medium tracking-tight mt-0.5">Catálogo</span>
    </a>

    <!-- Central Action: WhatsApp Instant Lead -->
    <a href="https://wa.me/18299595350?text=Hola,%20deseo%20informaci%C3%B3n%20sobre%20proyectos%20inmobiliarios%20en%20Rep%C3%BAblica%20Dominicana." target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center -mt-5 group" aria-label="Escribir por WhatsApp">
      <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-[#25D366] to-[#128C7E] text-white flex items-center justify-center shadow-lg shadow-[#25D366]/40 border-2 border-white group-active:scale-95 transition-transform duration-200">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.299.144.35.491 1.198.534 1.285.043.087.072.188.014.303-.058.116-.087.188-.173.289l-.26.302c-.087.087-.179.181-.077.355.101.174.45 1.743 1.942 2.378.291.124.502.13.682.028.188-.107.391-.376.549-.607.16-.231.319-.188.535-.101.217.087 1.373.647 1.611.765.239.118.399.176.457.276.058.101.058.586-.086.991zm-3.392-10.416c-4.428 0-8.026 3.598-8.026 8.026 0 1.411.368 2.738 1.01 3.896l-1.074 3.923 4.027-1.056c1.118.61 2.392.955 3.743.955 4.429 0 8.027-3.598 8.027-8.026.001-4.428-3.597-8.026-8.027-8.026zm0 14.542c-1.229 0-2.38-.337-3.37-.923l-.241-.144-2.384.625.636-2.327-.158-.252c-.643-1.026-.983-2.221-.983-3.469 0-3.608 2.936-6.544 6.545-6.544 3.608 0 6.544 2.936 6.545 6.544 0 3.609-2.936 6.546-6.545 6.546z"/>
        </svg>
      </div>
      <span class="text-[10px] font-semibold text-[#128C7E] tracking-tight mt-0.5">Chat</span>
    </a>

    <!-- Servicios -->
    <a href="/services" class={`flex flex-col items-center justify-center py-1 px-1 transition-all group ${isServices ? 'text-gold' : 'text-navy/70 hover:text-gold'}`}>
      <div class={`p-1 rounded-xl transition-all ${isServices ? 'bg-gold/15 scale-110' : 'group-active:scale-95'}`}>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill={isServices ? "currentColor" : "none"} stroke="currentColor" stroke-width={isServices ? "1.5" : "2"} stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
      </div>
      <span class="text-[10px] font-medium tracking-tight mt-0.5">Servicios</span>
    </a>

    <!-- Contacto -->
    <a href="/contact" class={`flex flex-col items-center justify-center py-1 px-1 transition-all group ${isContact ? 'text-gold' : 'text-navy/70 hover:text-gold'}`}>
      <div class={`p-1 rounded-xl transition-all ${isContact ? 'bg-gold/15 scale-110' : 'group-active:scale-95'}`}>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill={isContact ? "currentColor" : "none"} stroke="currentColor" stroke-width={isContact ? "1.5" : "2"} stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 1.37h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
      </div>
      <span class="text-[10px] font-medium tracking-tight mt-0.5">Contacto</span>
    </a>

  </div>
</nav>

<style>
  .pb-safe {
    padding-bottom: max(0.5rem, env(safe-area-inset-bottom));
  }
</style>
