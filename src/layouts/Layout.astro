---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MobileAppTabBar from '../components/MobileAppTabBar.astro';
import '../styles/global.css';

interface Props {
	title: string;
    navTheme?: 'dark' | 'light';
    description?: string;
    image?: string;
    url?: string;
    customSchema?: Record<string, any>;
}

const { 
    title, 
    navTheme = 'dark',
    description = "Constructora Rodríguez Javier - Desarrollos Inmobiliarios y Diseño de Interiores en Santo Domingo.",
    image = "https://www.rodriguezjaviers.com/assets/images/hero/hero-bg.webp",
    url = Astro.url.pathname,
    customSchema
} = Astro.props;

const cleanPath = url.endsWith('/') && url.length > 1 ? url.slice(0, -1) : url;
const canonicalUrl = new URL(cleanPath, Astro.site || 'https://www.rodriguezjaviers.com').href;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <meta name="theme-color" content="#0d1f3c">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="CRJ Inmobiliaria">
    <link rel="apple-touch-icon" href="/assets/lorenzo-logo.webp">
    <title>{title}</title>
    <meta name="description" content={description}>
    
    <!-- OpenGraph Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Canonical, Sitemap & Hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" hreflang="es" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta property="og:locale" content="es_DO" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-C661M62200"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-C661M62200');
    </script>

    <!-- JSON-LD Schema (Organization & RealEstateAgent) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "RealEstateAgent",
      "@id": "https://www.rodriguezjaviers.com/#realestateagent",
      "name": "Constructora Rodríguez Javier",
      "legalName": "Constructora Rodríguez Javier SRL",
      "url": "https://www.rodriguezjaviers.com/",
      "logo": "https://www.rodriguezjaviers.com/assets/lorenzo-logo.webp",
      "image": "https://www.rodriguezjaviers.com/assets/images/hero/hero-bg.webp",
      "description": "Líder en bienes raíces, construcción de villas de lujo y proyectos residenciales en República Dominicana.",
      "telephone": "+18299595350",
      "priceRange": "$$$$",
      "currenciesAccepted": "USD, DOP",
      "paymentAccepted": "Cash, Credit Card, Bank Transfer, Financing",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Prado Oriental",
        "addressLocality": "Santo Domingo Este",
        "addressRegion": "Santo Domingo",
        "postalCode": "11500",
        "addressCountry": "DO"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 18.4861,
        "longitude": -69.9312
      },
      "areaServed": [
        { "@type": "Country", "name": "Dominican Republic" },
        { "@type": "City", "name": "Santo Domingo" },
        { "@type": "City", "name": "Santo Domingo Este" },
        { "@type": "City", "name": "Punta Cana" },
        { "@type": "City", "name": "Las Terrenas" }
      ],
      "knowsAbout": [
        "Bienes Raíces en República Dominicana",
        "Villas de Lujo en Venta",
        "Apartamentos en Santo Domingo",
        "Inversión Inmobiliaria con Ley de Confotur",
        "Construcción Sismorresistente",
        "Comprar Casa en RD para Extranjeros"
      ]
    })} />

    {customSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(customSchema)} />
    )}
    
    <!-- Google Fonts with display=swap for zero layout shifts and high LCP score -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Language detection runs FIRST (blocking) to avoid flash of wrong language -->
    <script src="/js/lang.js?v=6" is:inline></script>
</head>
<body>
    <Nav theme={navTheme} />
    
    <main class="pb-20 md:pb-0">
        <slot />
    </main>

    <Footer />
    <MobileAppTabBar />

    <!-- App logic runs after DOM is ready -->
    <script src="/js/app.js?v=6" is:inline></script>
</body>
</html>
