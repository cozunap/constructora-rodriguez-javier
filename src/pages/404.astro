---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página No Encontrada (404) | Constructora Rodríguez Javier" description="La página que busca no existe o ha sido reubicada. Explore nuestro catálogo de bienes raíces en República Dominicana.">
  <section class="min-h-[70vh] flex items-center justify-center py-32 bg-off-white text-center">
    <div class="max-w-xl mx-auto px-6">
      <p class="text-sm font-semibold tracking-[0.2em] uppercase text-gold mb-4">Error 404</p>
      <h1 class="font-serif text-5xl md:text-6xl text-navy mb-6">Página No Encontrada</h1>
      <p class="text-muted text-lg mb-10">La propiedad o sección que buscas no está disponible o ha cambiado de enlace.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-gold">Volver al Inicio</a>
        <a href="/properties" class="btn-outline">Ver Propiedades</a>
      </div>
    </div>
  </section>
</Layout>
